# ── Backend API ──────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3001
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# ── Keycloak (Auth) ──────────────────────────────────────────────────────────
VITE_KEYCLOAK_URL=http://localhost:8090
VITE_KEYCLOAK_REALM=regieart
VITE_KEYCLOAK_CLIENT_ID=regieart-mobile

EXPO_PUBLIC_KEYCLOAK_URL=http://localhost:8090
EXPO_PUBLIC_KEYCLOAK_REALM=regieart
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=regieart-mobile

# ── Cloudflare R2 (Storage) ──────────────────────────────────────────────────
VITE_CLOUDFLARE_R2_PUBLIC_URL=https://pub.r2.dev
EXPO_PUBLIC_CLOUDFLARE_R2_PUBLIC_URL=https://pub.r2.dev

# ── Mobile (Expo LAN) ────────────────────────────────────────────────────────
# IP de tu máquina en la red local (para que el móvil alcance el Metro bundler)
HOST_IP=192.168.1.100
